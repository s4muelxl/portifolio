{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/projetos.html",
      "destination": "/#projetos",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/#experiencia",
      "permanent": true
    },
    {
      "source": "/especialidades.html",
      "destination": "/#tecnologias",
      "permanent": true
    },
    {
      "source": "/formacao.html",
      "destination": "/#formacao",
      "permanent": true
    },
    {
      "source": "/contato.html",
      "destination": "/#contato",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-xRpmgZofU1X2ck/JhvMrApKtlzUCPEC7ASdFG+yiPyw=' 'sha256-eJD/uAtmIIpGeKLyIVRYFpJZAmTI/7bR+kLhwHuSfAY=' 'sha256-2bEDSl21kxZJhXP8SuFNQ9xYzHIni7J+TkFZRfFxxqE=' 'sha256-jUCnTp5dHoHKsZ4bR2mGY62hGvzoCSFFtE6Lr85YyEg=' 'sha256-LLSVeBGNAATnXG2aOPPU2KlJqSi2hXlfL0ysBdxz2NE=' 'sha256-IJeXIh/7Y3Oq22ClcRTsLmoXRFrveZvblLaUpz8CvHk=' 'sha256-Vg7SrOIu7UR/xsNZ5netd4yEXGNa+rPmDv8/j0I3KQg='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
